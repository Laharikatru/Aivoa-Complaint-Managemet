# Copy to .env and fill in your own values.
# NEVER commit a real .env file or paste real secrets anywhere public.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# Example: postgresql://user:password@localhost:5432/complaint_mgmt
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/complaint_mgmt

FRONTEND_ORIGIN=http://localhost:5173
